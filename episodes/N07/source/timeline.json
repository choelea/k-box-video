      "end": 152.33495800000003,
      "text": "可以导出给外部 Agent 使用"
    },
    {
      "start": 152.48279100000002,
      "end": 155.35950000000003,
      "text": "也可以在平台内部多个智能体之间共享"
    },
    {
      "start": 156.11262500000004,
      "end": 158.52062500000002,
      "text": "Skill 的价值在于封装和复用"
    },
    {
      "start": 158.65729100000004,
      "end": 160.41791600000005,
      "text": "一次配置、多处使用"
    },
    {
      "start": 160.55462500000002,
      "end": 163.04066600000004,
      "text": "并且可以通过版本管理持续维护"
    },
    {
      "start": 163.42870800000003,
      "end": 167.39916600000004,
      "text": "适合把某类业务知识服务标准化输出给多个调用方"
    },
    {
      "start": 168.54662500000003,
      "end": 170.25145700000004,
      "text": "简单对比三种方式"
    },
    {
      "start": 170.63950000000003,
      "end": 173.03629100000003,
      "text": "Open API 适合程序化集成"
    },
    {
      "start": 173.21762500000003,
      "end": 176.73045700000003,
      "text": "调用方需要精确控制检索参数和返回结构"
    },
    {
      "start": 176.82254100000003,
      "end": 179.31974900000003,
      "text": "比如业务系统对接、数据同步"
    },
    {
      "start": 180.05262500000003,
      "end": 182.65029100000004,
      "text": "MCP 适合 AI Agent 集成"
    },
    {
      "start": 182.775875,
      "end": 185.79766600000002,
      "text": "Agent 自主决定何时调用、查什么内容"
    },
    {
      "start": 185.87316600000003,
      "end": 188.54899900000004,
      "text": "适合对话式场景和多工具组合"
    },
    {
      "start": 189.30262500000003,
      "end": 191.50970800000002,
      "text": "Skill 适合能力封装和复用"
    },
    {
      "start": 191.69104100000004,
      "end": 194.23291600000005,
      "text": "把一组知识资源和调用规则打包"
    },
    {
      "start": 194.34729100000004,
      "end": 196.33112500000004,
      "text": "标准化输出给多个使用方"
    },
    {
      "start": 197.08862500000004,
      "end": 199.06133200000002,
      "text": "如果你的系统是自己开发的"
    },
    {
      "start": 199.20916600000004,
      "end": 201.09254100000004,
      "text": "用 Open API 最直接"
    },
    {
      "start": 201.29625000000001,
      "end": 203.28008300000005,
      "text": "如果已经有 Agent 框架在用"
    },
    {
      "start": 203.35562500000003,
      "end": 205.14970800000003,
      "text": "优先用 MCP 接入"
    },
    {
      "start": 205.37570800000003,
      "end": 207.96220800000003,
      "text": "如果想把某类知识能力标准化输出"
    },
    {
      "start": 208.02079100000003,
      "end": 209.05595800000003,
      "text": "就做一个 Skill"
    },
    {
      "start": 210.19462500000003,
      "end": 212.93741600000004,
      "text": "我们来看三种接入方式的实际界面"
    },
    {
      "start": 213.32545800000003,
      "end": 214.52804100000003,
      "text": "这是 Skill 中心"
    },
    {
      "start": 214.63125000000002,
      "end": 216.43654100000003,
      "text": "可以看到已创建的能力包"
    },
    {
      "start": 216.58437500000002,
      "end": 218.65750000000003,
      "text": "每个 Skill 绑定了哪些知识库"
    },
    {
      "start": 218.73837500000002,
      "end": 220.52133300000003,
      "text": "支持版本管理和导出"
    },
    {
      "start": 221.26862500000004,
      "end": 223.65424900000005,
      "text": "这是 MCP 服务的配置页面"
    },
    {
      "start": 223.82445800000002,
      "end": 225.35695800000005,
      "text": "外部 Agent 通过连接这"
    },
    {
      "start": 225.38695800000005,
      "end": 227.94000000000003,
      "text": "个地址就能自动发现可用工具"
    },
    {
      "start": 228.69462500000003,
      "end": 230.84587500000004,
      "text": "这是 Open API 的调试界面"
    },
    {
      "start": 230.96025000000003,
      "end": 234.28337400000004,
      "text": "可以直接发送检索请求并查看返回结果"
    },
    {
      "start": 234.46475,
      "end": 238.05033300000002,
      "text": "包含命中的片段、相关度分数和原文链接"
    },
    {
      "start": 239.18462500000004,
      "end": 241.17475000000002,
      "text": "API、MCP、Skill "
    },
    {
      "start": 241.20475000000002,
      "end": 244.21537500000002,
      "text": "三种接入方式分别对应三种使用场景"
    },
    {
      "start": 244.39670800000005,
      "end": 248.35062400000004,
      "text": "程序化集成、Agent 自主调用、能力标准化复用"
    },
    {
      "start": 249.10662500000004,
      "end": 251.29137500000004,
      "text": "选择的关键不是哪个更好"
    },
    {
      "start": 251.46154100000004,
      "end": 254.09270800000004,
      "text": "而是谁在用、怎么用、用在哪里"
    },
    {
      "start": 254.48075000000003,
      "end": 258.28375000000005,
      "text": "根据调用方的身份和运行条件选择合适的方式"
    },
    {
      "start": 258.36466600000006,
      "end": 261.77708300000006,
      "text": "才能把 K-BOX 的知识能力真正融入业务系统"
    },
    {
      "start": 262.1705,
      "end": 265.739166,
      "text": "下次我们继续探讨问学知识平台的更多能力"
    }
  ]
}
