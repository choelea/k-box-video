      "text": "文档问答适合答案在某一段文档中可以直接找到的情况"
    },
    {
      "start": 167.95087500000002,
      "end": 171.29633300000003,
      "text": "问题是是什么、怎么操作、规定是什么"
    },
    {
      "start": 172.04662500000003,
      "end": 176.28495800000002,
      "text": "知识图谱适合答案需要从多个实体和关系中推导的情况"
    },
    {
      "start": 176.488625,
      "end": 178.47333300000003,
      "text": "问题是'谁和谁有关'、'经过"
    },
    {
      "start": 178.50333300000003,
      "end": 181.50279100000003,
      "text": "哪些环节'、'历史上类似情况怎么处理'"
    },
    {
      "start": 182.25662500000004,
      "end": 183.20254100000005,
      "text": "简单判断"
    },
    {
      "start": 183.42850000000004,
      "end": 186.86324900000005,
      "text": "如果你的问题经常涉及关系、链路、追溯"
    },
    {
      "start": 187.10037500000004,
      "end": 189.26279100000005,
      "text": "而且答案散布在多个来源"
    },
    {
      "start": 189.33833300000003,
      "end": 191.23291600000005,
      "text": "那就值得评估知识图谱"
    },
    {
      "start": 192.38662500000004,
      "end": 195.68741600000004,
      "text": "知识图谱把业务实体和关系显式组织起来"
    },
    {
      "start": 195.84645800000004,
      "end": 198.24325000000005,
      "text": "让系统能够回答多跳推理问题"
    },
    {
      "start": 198.99662500000005,
      "end": 201.89562500000005,
      "text": "当文档问答无法覆盖关系型查询时"
    },
    {
      "start": 202.04350000000005,
      "end": 204.42912400000006,
      "text": "图谱就是下一步值得建设的能力"
    },
    {
      "start": 204.81716600000004,
      "end": 208.38583200000005,
      "text": "下次我们继续探讨问学知识平台的更多能力"
    }
  ]
}
