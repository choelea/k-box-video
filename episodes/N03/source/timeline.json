      "end": 93.64195800000002,
      "text": "员工可以阅读、检索和追问"
    },
    {
      "start": 94.03533300000001,
      "end": 95.89641600000002,
      "text": "企业 Wiki 的核心价值是"
    },
    {
      "start": 96.04425,
      "end": 99.66875000000002,
      "text": "把分散资料变成可阅读、可追溯的知识入口"
    },
    {
      "start": 100.414625,
      "end": 102.80025,
      "text": "以中国电影前500知识库为例"
    },
    {
      "start": 102.875791,
      "end": 107.37079100000001,
      "text": "平台从5份精选文档中自动生成了557个主题页面"
    },
    {
      "start": 107.552125,
      "end": 110.28374900000001,
      "text": "涵盖影片、导演、演员等实体"
    },
    {
      "start": 111.032625,
      "end": 111.67716600000001,
      "text": "首先"
    },
    {
      "start": 111.791583,
      "end": 114.054416,
      "text": "我们来看 Wiki 主题页面列表"
    },
    {
      "start": 114.442458,
      "end": 116.448625,
      "text": "点击进入一个主题详情页"
    },
    {
      "start": 116.585333,
      "end": 120.645083,
      "text": "可以看到每个页面汇总了分散在不同文档中的相关信息"
    },
    {
      "start": 120.725958,
      "end": 121.78345800000001,
      "text": "并标注来源"
    },
    {
      "start": 121.931291,
      "end": 123.006208,
      "text": "比如「《八佰》票房31.1亿"
    },
    {
      "start": 123.036208,
      "end": 126.203083,
      "text": "元」可以直接追溯到原始文档"
    },
    {
      "start": 126.954625,
      "end": 127.6215,
      "text": "接下来"
    },
    {
      "start": 127.747041,
      "end": 130.221958,
      "text": "我们看一下 Wiki 问答对话演示"
    },
    {
      "start": 130.358666,
      "end": 132.77775,
      "text": "了解如何对 Wiki 内容进行追问"
    },
    {
      "start": 133.916625,
      "end": 135.61029100000002,
      "text": "第三类是知识图谱"
    },
    {
      "start": 135.998333,
      "end": 139.656291,
      "text": "适合需要追问实体关系、路径和影响的场景"
    },
    {
      "start": 140.049666,
      "end": 144.756708,
      "text": "平台从文档中抽取人物、产品、系统等实体及其关系"
    },
    {
      "start": 144.960375,
      "end": 147.301374,
      "text": "支持关系查询和多跳探索"
    },
    {
      "start": 147.69475,
      "end": 149.5,
      "text": "知识图谱的核心价值是"
    },
    {
      "start": 149.681375,
      "end": 152.569208,
      "text": "回答「谁和谁有什么关系」这类结构化问题"
    },
    {
      "start": 153.318625,
      "end": 154.621666,
      "text": "以电影图谱为例"
    },
    {
      "start": 154.747208,
      "end": 159.47662499999998,
      "text": "它从影片、导演、演员三类实体中构建了完整的关系网络"
    },
    {
      "start": 160.216625,
      "end": 160.872333,
      "text": "首先"
    },
    {
      "start": 161.031375,
      "end": 162.57995799999998,
      "text": "我们来看图谱库列表"
    },
    {
      "start": 162.738958,
      "end": 165.31433299999998,
      "text": "这里展示了已构建的知识图谱集合"
    },
    {
      "start": 165.702375,
      "end": 166.793333,
      "text": "点击进入后"
    },
    {
      "start": 166.88537499999998,
      "end": 169.282166,
      "text": "可以看到知识图谱的可视化界面"
    },
    {
      "start": 169.40770799999999,
      "end": 171.525458,
      "text": "展示了实体之间的关系网络"
    },
    {
      "start": 172.274625,
      "end": 172.930333,
      "text": "接下来"
    },
    {
      "start": 173.067041,
      "end": 175.36341599999997,
      "text": "我们看一下图谱问答查询演示"
    },
    {
      "start": 175.75141599999998,
      "end": 177.93124999999998,
      "text": "用户可以问「陈凯歌导演了哪些"
    },
    {
      "start": 177.96124999999998,
      "end": 180.681708,
      "text": "电影」或「《长津湖》的主演还演过什么」"
    },
    {
      "start": 180.76258299999998,
      "end": 183.80666599999998,
      "text": "图谱会沿着关系路径给出结构化答案"
    },
    {
      "start": 184.548625,
      "end": 187.018625,
      "text": "新能源汽车归档图谱则关联了故"
    },
    {
      "start": 187.048625,
      "end": 190.55037499999997,
      "text": "障码、零部件、批次、供应商和车型"
    },
    {
      "start": 190.63124999999997,
      "end": 191.93425,
      "text": "支持质量追溯"
    },
    {
      "start": 193.07062499999998,
      "end": 194.74199899999996,
      "text": "第四类是数据洞察"
    },
    {
      "start": 195.12999999999997,
      "end": 198.93304099999997,
      "text": "适合用户需要用自然语言查询业务数据的场景"
    },
    {
      "start": 199.32645799999997,
      "end": 203.10716599999998,
      "text": "平台结合数据库结构、业务概念和指标口径"
    },
    {
      "start": 203.31083299999997,
      "end": 206.70091599999998,
      "text": "把自然语言问题转化为可执行的查询语句"
    },
    {
      "start": 207.09429099999997,
      "end": 208.96654099999998,
      "text": "数据洞察的核心价值是"
    },
    {
      "start": 209.11437499999997,
      "end": 213.26341599999998,
      "text": "让不懂 SQL 的用户也能安全、准确地查询业务数据"
    },
    {
      "start": 214.00862499999997,
      "end": 216.62862399999997,
      "text": "以星途新能源售后运营数据为例"
    },
    {
      "start": 216.78766599999994,
      "end": 218.49249899999995,
      "text": "它连接了14张业务表"
    },
    {
      "start": 218.64033299999997,
      "end": 223.92241599999997,
      "text": "涵盖客户、车辆、零部件、供应商、维修记录和工单等数据"
    },
    {
      "start": 224.67462499999996,
      "end": 225.30799999999996,
      "text": "首先"
    },
    {
      "start": 225.46704099999997,
      "end": 227.17187499999997,
      "text": "我们来看数据主题列表"
    },
    {
      "start": 227.33087499999996,
      "end": 229.68304099999995,
      "text": "这里展示了已接入的业务数据源"
    },
    {
      "start": 230.05991599999996,
      "end": 231.11741599999996,
      "text": "点击进入后"
    },
    {
      "start": 231.17599999999996,
      "end": 233.11516599999996,
      "text": "可以看到业务表结构详情"
    },
    {
      "start": 233.50858299999996,
      "end": 235.88929099999996,
      "text": "平台预定义了「未关闭工单数量"
    },
    {
      "start": 235.91929099999996,
      "end": 238.17095799999996,
      "text": "」「高价值客户数量」等业务概念"
    },
    {
      "start": 238.91662499999995,
      "end": 239.59466599999996,
      "text": "接下来"
    },
    {
      "start": 239.72020799999996,
      "end": 241.93845799999994,
      "text": "我们看一下数据洞察问答演示"
    },
    {
      "start": 242.32645799999995,
      "end": 244.58441599999995,
      "text": "用户可以直接问「本月有多少未"
    },
    {
      "start": 244.61441599999995,
      "end": 247.79245799999995,
      "text": "关闭工单」或「VIP客户的故障率是多少」"
    },
    {
      "start": 247.88449999999995,
      "end": 251.00670799999995,
      "text": "平台会生成对应的 SQL 并返回结果"
    },
    {
      "start": 252.16662499999995,
      "end": 253.38037399999996,
      "text": "怎样选择起点"
    },
    {
      "start": 253.76841599999995,
      "end": 255.94199899999995,
      "text": "这里给出一个简单的判断框架"
    },
    {
      "start": 256.68862499999994,
      "end": 259.04079099999996,
      "text": "如果问题是查原文、找依据"
    },
    {
      "start": 259.16633299999995,
      "end": 260.55866599999996,
      "text": "先选文档知识库"
    },
    {
      "start": 261.30662499999994,
      "end": 264.02708199999995,
      "text": "如果问题是汇总知识、沉淀主题"
    },
    {
      "start": 264.10799999999995,
      "end": 265.33291599999995,
      "text": "选企业 Wiki"
    },
    {
      "start": 266.06862499999994,
      "end": 268.72212399999995,
      "text": "如果问题是追问关系、探索路径"
    },
    {
      "start": 268.82533299999994,
      "end": 269.93866599999996,
      "text": "选知识图谱"
    },
    {
      "start": 270.68662499999994,
      "end": 273.25083299999994,
      "text": "如果问题是查数据、看指标"
    },
    {
      "start": 273.34287499999994,
      "end": 274.44504099999995,
      "text": "选数据洞察"
    },
    {
      "start": 275.1846249999999,
      "end": 276.20866599999994,
      "text": "实际业务中"
    },
    {
      "start": 276.25608299999993,
      "end": 277.64837399999993,
      "text": "可以组合多条路径"
    },
    {
      "start": 277.8408749999999,
      "end": 280.75104099999993,
      "text": "先用文档验证知识能否支撑回答"
    },
    {
      "start": 280.8042909999999,
      "end": 282.7769569999999,
      "text": "再用 Wiki 沉淀稳定主题"
    },
    {
      "start": 282.8913329999999,
      "end": 285.3439159999999,
      "text": "必要时接入图谱或数据洞察"
    },
    {
      "start": 286.4906249999999,
      "end": 289.2668749999999,
      "text": "这就是问学知识平台的四类知识能力"
    },
    {
      "start": 289.6549159999999,
      "end": 291.0137499999999,
      "text": "从业务问题出发"
    },
    {
      "start": 291.1392909999999,
      "end": 292.7994579999999,
      "text": "选择合适的知识形态"
    },
    {
      "start": 292.9473329999999,
      "end": 295.7682489999999,
      "text": "让企业资料成为可信的业务上下文"
    }
  ]
