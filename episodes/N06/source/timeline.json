    {
      "start": 194.146583,
      "end": 195.940708,
      "text": "新的关系图节点被补充"
    },
    {
      "start": 196.06620800000002,
      "end": 197.44737400000002,
      "text": "业务概念更丰富"
    },
    {
      "start": 197.534083,
      "end": 200.064791,
      "text": "QueryMemory的查询规则更完善"
    },
    {
      "start": 200.81062500000002,
      "end": 202.79445800000002,
      "text": "这就是业务语义治理的核心"
    },
    {
      "start": 202.975833,
      "end": 205.39491600000002,
      "text": "从用户的真实提问中持续学习"
    },
    {
      "start": 205.470458,
      "end": 208.10162400000002,
      "text": "让数据主题越来越贴近业务理解"
    },
    {
      "start": 209.26062500000003,
      "end": 212.38287400000004,
      "text": "不是所有的数据查询都需要业务语义治理"
    },
    {
      "start": 212.77091600000003,
      "end": 215.87079100000003,
      "text": "如果你的问题是查一下某张表有多少行"
    },
    {
      "start": 216.00750000000002,
      "end": 217.80162400000003,
      "text": "或者某个字段的值是什么"
    },
    {
      "start": 217.88250000000002,
      "end": 219.54270800000003,
      "text": "直接查数据库就够了"
    },
    {
      "start": 220.28662500000004,
      "end": 222.38208300000005,
      "text": "但以下情况需要语义治理"
    },
    {
      "start": 222.55225000000004,
      "end": 226.17670800000005,
      "text": "业务指标有明确定义且不同部门需要对齐口径"
    },
    {
      "start": 226.22995800000004,
      "end": 229.64237500000004,
      "text": "一个问题需要关联多张表才能得到正确结果"
    },
    {
      "start": 229.89066600000004,
      "end": 232.47720800000005,
      "text": "非技术用户需要用自然语言提问"
    },
    {
      "start": 232.55808300000004,
      "end": 234.40800000000004,
      "text": "但数据库结构太复杂"
    },
    {
      "start": 235.15262500000006,
      "end": 236.06504100000006,
      "text": "简单来说"
    },
    {
      "start": 236.26870800000006,
      "end": 239.79270700000006,
      "text": "当问题和数据库能回答的之间有翻译成本时"
    },
    {
      "start": 239.85129100000006,
      "end": 241.14320800000004,
      "text": "就需要语义治理"
    },
    {
      "start": 242.28262500000005,
      "end": 245.51650000000004,
      "text": "自然语言问数的难点不在于理解自然语言"
    },
    {
      "start": 245.70900000000003,
      "end": 248.93166600000006,
      "text": "而在于把业务口径翻译成正确的数据查询"
    },
    {
      "start": 249.68462500000004,
      "end": 252.29975000000002,
      "text": "业务语义治理通过数据主题弥合"
    },
    {
      "start": 252.32975000000002,
      "end": 254.72650000000004,
      "text": "物理表和业务理解之间的差距"
    },
    {
      "start": 254.81320800000003,
      "end": 258.28141600000004,
      "text": "让系统给出的答案和业务部门的理解一致"
    },
    {
      "start": 258.67483300000004,
      "end": 262.24349900000004,
      "text": "下次我们继续探讨问学知识平台的更多能力"
