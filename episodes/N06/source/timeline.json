      "end": 121.92537500000002,
      "text": "我们来看一个实际案例"
    },
    {
      "start": 122.30220800000001,
      "end": 125.08962400000001,
      "text": "这是一个新能源汽车售后的数据主题"
    },
    {
      "start": 125.23750000000001,
      "end": 126.85300000000001,
      "text": "页面左侧是关系图"
    },
    {
      "start": 126.94508300000001,
      "end": 129.549,
      "text": "展示了故障码、生产批次、装配"
    },
    {
      "start": 129.579,
      "end": 132.21016600000002,
      "text": "车型等业务概念之间的关联关系"
    },
    {
      "start": 132.956625,
      "end": 134.76191599999999,
      "text": "右侧是业务概念列表"
    },
    {
      "start": 134.920916,
      "end": 137.674833,
      "text": "每个概念都对应具体的物理表和字段"
    },
    {
      "start": 138.062875,
      "end": 139.79,
      "text": "下方是QueryMemory"
    },
    {
      "start": 139.960208,
      "end": 143.551208,
      "text": "记录了系统对这些业务概念的理解和查询规则"
    },
    {
      "start": 144.294625,
      "end": 146.36287499999997,
      "text": "这些关系图、业务概念和Que"
    },
    {
      "start": 146.39287499999998,
      "end": 149.32537399999998,
      "text": "ryMemory构成了数据主题的语义基础"
    },
    {
      "start": 149.40087499999998,
      "end": 152.009749,
      "text": "让系统知道如何理解用户的提问"
    },
    {
      "start": 153.152625,
      "end": 155.649874,
      "text": "当用户在智能体中提出问题时"
    },
    {
      "start": 155.808875,
      "end": 158.495874,
      "text": "系统会依据数据主题中的语义规则"
    },
    {
      "start": 158.56025,
      "end": 160.901208,
      "text": "自动生成对应的SQL查询"
    },
    {
      "start": 161.658625,
      "end": 163.765249,
      "text": "页面展示了完整的问答过程"
    },
    {
      "start": 163.935416,
      "end": 167.225041,
      "text": "用户的自然语言问题被翻译成精确的SQL"
    },
    {
      "start": 167.31175,
      "end": 169.708541,
      "text": "系统执行查询并返回结果"
    },
    {
      "start": 170.452625,
      "end": 171.39854100000002,
      "text": "更重要的是"
    },
    {
      "start": 171.57987500000002,
      "end": 173.831583,
      "text": "每次问答都会反哺数据主题"
    },
    {
      "start": 173.945958,
      "end": 176.332458,
      "text": "新的关系图节点、业务概念和Q"
    },
    {
      "start": 176.362458,
      "end": 178.245833,
      "text": "ueryMemory会自动沉淀"
    },
    {
      "start": 178.393708,
      "end": 179.998083,
      "text": "让系统越用越聪明"
    },
    {
      "start": 181.13462500000003,
      "end": 182.25908300000003,
      "text": "除了单次问答"
    },
    {
      "start": 182.41812500000003,
      "end": 185.39524900000004,
      "text": "系统还能对历史对话进行批量治理"
    },
    {
      "start": 185.78329100000002,
      "end": 187.32070700000003,
      "text": "选择一段对话记录"
    },
    {
      "start": 187.47975000000002,
      "end": 190.76937500000003,
      "text": "系统会分析其中的业务概念和查询模式"
    },
    {
      "start": 191.512625,
      "end": 192.53666600000003,
      "text": "治理完成后"
    },
    {
      "start": 192.673375,
