      "start": 138.24125000000004,
      "end": 140.43716600000002,
      "text": "并在必要时回读来源文档"
    },
    {
      "start": 140.52920800000004,
      "end": 141.92154100000002,
      "text": "给出带引用的回答"
    },
    {
      "start": 143.07062500000004,
      "end": 145.09912500000004,
      "text": "企业 Wiki 适合这些场景"
    },
    {
      "start": 145.224666,
      "end": 146.77325000000002,
      "text": "资料分散、重复"
    },
    {
      "start": 146.89875000000004,
      "end": 148.81562400000004,
      "text": "需要整理成稳定的主题页"
    },
    {
      "start": 148.86887500000003,
      "end": 150.88620800000004,
      "text": "知识需要长期维护和更新"
    },
    {
      "start": 151.08983300000003,
      "end": 154.23441600000004,
      "text": "员工需要一个可阅读、可检索的知识入口"
    },
    {
      "start": 154.98462500000002,
      "end": 156.48854100000003,
      "text": "如果资料经常变化"
    },
    {
      "start": 156.614125,
      "end": 159.368041,
      "text": "或者同一个主题的信息散落在多处"
    },
    {
      "start": 159.45475000000002,
      "end": 162.81133300000002,
      "text": "Wiki 可以帮助保持知识的一致性和完整性"
    },
    {
      "start": 163.96262500000003,
      "end": 166.25895800000004,
      "text": "Wiki 和文档问答有什么区别"
    },
    {
      "start": 166.64700000000002,
      "end": 168.90987400000003,
      "text": "文档问答适合直接查原文"
    },
    {
      "start": 169.02425000000002,
      "end": 170.72908200000003,
      "text": "答案必须精确到条款"
    },
    {
      "start": 171.48462500000002,
      "end": 175.946166,
      "text": "Wiki 更适合需要综合多处信息、形成完整认知的场景"
    },
    {
      "start": 176.33420800000002,
      "end": 178.85375000000002,
      "text": "它把分散的知识点聚合成主题"
    },
    {
      "start": 178.96812500000001,
      "end": 180.43858300000002,
      "text": "方便阅读和理解"
    },
    {
      "start": 181.190625,
      "end": 183.274958,
      "text": "如果只是临时回答少量问题"
    },
    {
      "start": 183.40045800000001,
      "end": 185.73029100000002,
      "text": "先验证文档库和智能体即可"
    },
    {
      "start": 185.96741600000001,
      "end": 188.11866600000002,
      "text": "如果同一主题被反复查询"
    },
    {
      "start": 188.205375,
      "end": 190.490541,
      "text": "再评估 Wiki 的页面维护收益"
    },
    {
      "start": 191.63262500000002,
      "end": 193.533458,
      "text": "企业 Wiki 把分散的资料"
    },
    {
      "start": 193.563458,
      "end": 196.18341600000002,
      "text": "变成可阅读、可追溯的主题知识"
    },
    {
      "start": 196.35362500000002,
      "end": 198.53833300000002,
      "text": "让企业知识真正沉淀下来"
    },
    {
      "start": 199.27462500000001,
      "end": 202.84329100000002,
      "text": "下次我们继续探讨问学知识平台的更多能力"
    }
  ]
}
