      "text": "这条链路可以连接制度文档、产品资料和操作手册"
    },
    {
      "start": 165.00291599999997,
      "end": 168.38183199999997,
      "text": "问学承担知识处理、治理、检索和供给"
    },
    {
      "start": 168.57433299999997,
      "end": 171.39520699999997,
      "text": "大模型基于获得的上下文生成回答"
    },
    {
      "start": 172.15462499999998,
      "end": 175.47779099999997,
      "text": "知识也可以通过接口等方式供给其他应用"
    },
    {
      "start": 175.86579099999997,
      "end": 177.99474899999998,
      "text": "需要治理的是同一批内容"
    },
    {
      "start": 178.12024999999997,
      "end": 180.07062399999998,
      "text": "使用它的入口可以有多个"
    },
    {
      "start": 180.804625,
      "end": 182.598749,
      "text": "涉及新旧制度冲突时"
    },
    {
      "start": 182.65733299999997,
      "end": 184.629999,
      "text": "还要核对时间和适用范围"
    },
    {
      "start": 184.811333,
      "end": 186.002749,
      "text": "涉及权限时"
    },
    {
      "start": 186.08945799999998,
      "end": 188.30766599999998,
      "text": "要用实际使用者的身份验证"
    },
    {
      "start": 188.70108299999998,
      "end": 190.774208,
      "text": "不能仅凭一个管理账号的演示"
    },
    {
      "start": 190.91087499999998,
      "end": 193.106791,
      "text": "就认定这些问题已经解决"
    },
    {
      "start": 194.270625,
      "end": 196.34379099999998,
      "text": "如果只是偶尔阅读几份材料"
    },
    {
      "start": 196.491625,
      "end": 199.145082,
      "text": "现有文档和模型工具就可能足够"
    },
    {
      "start": 199.896625,
      "end": 203.616625,
      "text": "如果知识需要持续更新、多应用复用、按身份控制"
    },
    {
      "start": 203.646625,
      "end": 206.65725,
      "text": "访问，并且回答需要能够核查依据"
    },
    {
      "start": 206.743958,
      "end": 209.319291,
      "text": "那么就值得评估问学这类知识平台"
    },
    {
      "start": 210.058625,
      "end": 211.953208,
      "text": "这集先说明为什么需要"
    },
    {
      "start": 212.34125,
      "end": 213.532666,
      "text": "后续任务实操"
    },
    {
      "start": 213.691666,
      "end": 217.874166,
      "text": "我们会完整演示如何把一批资料建成可用的知识服务"
    },
    {
      "start": 218.010875,
      "end": 219.525958,
      "text": "并验证实际效果"
    }
  ]
}
